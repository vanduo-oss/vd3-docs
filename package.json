{
  "name": "@vanduo-oss/vd3-docs",
  "version": "1.7.7",
  "description": "Documentation for the Vanduo Vue 3 design system, charts, and flowchart packages",
  "private": true,
  "type": "module",
  "homepage": "https://vd3.vanduo.dev/",
  "license": "MIT",
  "author": "vanduo-oss",
  "exports": {
    ".": "./src/main.ts"
  },
  "files": [
    "dist/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite-ssg build && node scripts/generate-sitemap.mjs && node scripts/generate-search.mjs",
    "preview": "vite preview --port 8787 --host",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "stylelint": "stylelint \"src/**/*.css\"",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\"",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:size": "node tests/scripts/size.mjs",
    "test:e2e": "playwright test --project='Chromium Desktop'",
    "test:e2e:full": "playwright test",
    "test:a11y": "playwright test a11y-smoke --project='Chromium Desktop'",
    "search:refresh": "node scripts/generate-search.mjs --refresh",
    "test:content": "node scripts/generate-search.mjs --check",
    "test:smoke": "playwright test global-search docs-navigation cbun-flowchart-responsive --project=\"Chromium Desktop\""
  },
  "dependencies": {
    "@unhead/vue": "2.1.15",
    "@vanduo-oss/vd3": "1.7.4",
    "@vanduo-oss/vd3-charts": "1.1.1",
    "@vanduo-oss/vd3-flowchart": "1.3.0",
    "animejs": "4.5.0",
    "fuse.js": "7.5.0",
    "pinia": "^3.0.4",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "@typescript-eslint/parser": "8.69.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "axe-core": "4.13.0",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "stylelint": "^17.15.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.69.0",
    "vite": "^8.2.2",
    "vite-ssg": "^28.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.28.2"
}
